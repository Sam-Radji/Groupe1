# Mot de passe root MariaDB (24 caractères minimum ; valeur simple réservée aux tests de cours).
MYSQL_ROOT_PASSWORD=cours_mysql_root_2026_test
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wp_user
# Mot de passe MariaDB de WordPress (24 caractères minimum ; valeur simple réservée aux tests de cours).
WORDPRESS_DB_PASSWORD=cours_wordpress_db_2026_test
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# Mot de passe PostgreSQL de n8n (24 caractères minimum ; valeur simple réservée aux tests de cours).
N8N_DB_PASSWORD=cours_n8n_postgres_2026_test
# Clé de chiffrement n8n (32 caractères minimum ; conserver la même valeur pour garder les identifiants déchiffrables).
N8N_ENCRYPTION_KEY=cours_n8n_encryption_key_2026_for_tests_only
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
# Mot de passe MariaDB de Zabbix (24 caractères minimum ; valeur simple réservée aux tests de cours).
ZABBIX_DB_PASSWORD=cours_zabbix_db_2026_test
# Mot de passe root MariaDB de Zabbix (24 caractères minimum ; valeur simple réservée aux tests de cours).
ZABBIX_DB_ROOT_PASSWORD=cours_zabbix_root_2026_test
